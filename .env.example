# --- Login (required) ---
APP_USERNAME=awais
APP_PASSWORD=choose-a-long-password
# Any long random string. Changing it logs everyone out.
AUTH_SECRET=paste-a-long-random-string

# --- Gmail (required to send) ---
GMAIL_USER=you@gmail.com
# 16-character App Password from https://myaccount.google.com/apppasswords
# (needs 2-Step Verification turned on). NOT your normal Gmail password.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Optional: the name creators see in their inbox
FROM_NAME=Awais

# --- Second Gmail account (optional) ---
# Add these and first emails rotate between both inboxes.
# Up to 5 accounts: GMAIL_USER_3 / GMAIL_APP_PASSWORD_3, and so on.
# GMAIL_USER_2=second@gmail.com
# GMAIL_APP_PASSWORD_2=abcd efgh ijkl mnop
# FROM_NAME_2=Awais

# --- Cloud save (optional) ---
# Added automatically when you connect Upstash Redis in Vercel > Storage.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
